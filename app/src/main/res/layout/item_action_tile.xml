<?xml version="1.0" encoding="utf-8"?>
<!--
    A home-screen action card: icon, title, one-line explanation.
    The host gives it a weighted height, so it grows to share the screen with
    the other tiles; minHeight keeps it a generous target on short screens.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:minHeight="@dimen/tile_min_height"
    android:padding="18dp"
    android:background="@drawable/bg_tile_red"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/tile_icon"
        android:layout_width="@dimen/tile_icon"
        android:layout_height="@dimen/tile_icon"
        android:contentDescription="@null"
        app:tint="@color/text_primary"
        tools:src="@drawable/ic_camera"/>

    <TextView
        android:id="@+id/tile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tile_title"
        android:textStyle="bold"
        tools:text="Image OCR"/>

    <TextView
        android:id="@+id/tile_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:alpha="0.85"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/tile_subtitle"
        tools:text="Capture or select image"/>
</LinearLayout>
