<?xml version="1.0" encoding="utf-8"?>
<!-- A home-screen action card: icon, title, one-line explanation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tile_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:minHeight="104dp"
    android:padding="14dp"
    android:background="@drawable/bg_tile_red"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/tile_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        app:tint="@color/text_primary"
        tools:src="@drawable/ic_camera"/>

    <TextView
        android:id="@+id/tile_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Image OCR"/>

    <TextView
        android:id="@+id/tile_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:alpha="0.85"
        android:textColor="@color/text_primary"
        android:textSize="11sp"
        tools:text="Capture or select image"/>
</LinearLayout>
