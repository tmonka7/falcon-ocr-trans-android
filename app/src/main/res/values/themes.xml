<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        The app is dark-only by design: it spends most of its time showing a
        camera preview or a photographed page, and a light chrome around those
        competes with the image for attention.
    -->
    <style name="Theme.FalconOcr" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand_red</item>
        <item name="colorOnPrimary">@color/text_on_accent</item>
        <item name="colorPrimaryContainer">@color/brand_red_dark</item>
        <item name="colorSecondary">@color/tile_blue</item>
        <item name="android:colorBackground">@color/bg_base</item>
        <item name="colorSurface">@color/bg_surface</item>
        <item name="colorSurfaceVariant">@color/bg_surface_high</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/divider</item>
        <item name="android:statusBarColor">@color/bg_base</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
    </style>

    <!-- Splash: the same theme with the brand mark as the window background,
         so there is no flash of empty surface before the first frame. -->
    <style name="Theme.FalconOcr.Splash" parent="Theme.FalconOcr">
        <item name="android:windowBackground">@color/bg_base</item>
    </style>

    <!-- Camera runs edge to edge; the preview is the background. -->
    <style name="Theme.FalconOcr.Camera" parent="Theme.FalconOcr">
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:windowTranslucentStatus">true</item>
    </style>

    <!-- Type scale -->
    <style name="TextAppearance.Falcon.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Falcon.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="TextAppearance.Falcon.Caption" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="TextAppearance.Falcon.SectionHeader" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- A settings or history row: full-width, tappable, with a chevron.
         parent="" is required: without it the dotted name makes AAPT look for a
         "Widget.Falcon" parent style that does not exist. -->
    <style name="Widget.Falcon.Row" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/row_min_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Buttons are sized from dimens tokens so they scale with the screen
         (values-sw600dp); see dimens.xml for the rationale. -->
    <style name="Widget.Falcon.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textSize">@dimen/button_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="backgroundTint">@color/brand_red</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Falcon.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textSize">@dimen/button_text</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <style name="Widget.Falcon.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textSize">@dimen/button_text</item>
        <item name="android:minHeight">@dimen/button_height</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="cornerRadius">14dp</item>
    </style>

</resources>
