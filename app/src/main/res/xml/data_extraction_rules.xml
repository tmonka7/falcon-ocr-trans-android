<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="falcon_ocr_prefs.xml"/>
        <include domain="database" path="history.db"/>
        <exclude domain="file" path="pages/"/>
        <exclude domain="file" path="exports/"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="falcon_ocr_prefs.xml"/>
        <include domain="database" path="history.db"/>
    </device-transfer>
</data-extraction-rules>
